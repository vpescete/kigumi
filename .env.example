# Meshble secrets — provide via the environment / a secret manager. NEVER commit real values.
# The instance refuses to start if a required secret is missing (fail-fast).

# REQUIRED — the single source of the database connection identity (a full Postgres DSN).
DATABASE_URL=postgres://meshble:CHANGE_ME@127.0.0.1:5432/meshble

# REQUIRED — HS256 signing secret for access/refresh tokens.
MESHBLE_JWT_SECRET=CHANGE_ME_long_random_value
# OPTIONAL — previous JWT secret, still accepted on verify during a rotation window.
# MESHBLE_JWT_SECRET_OLD=

# OPTIONAL — required only if [mail].smtp_host is configured.
# MESHBLE_SMTP_PASSWORD=

# OPTIONAL — bearer token gating destructive db ops (dump/restore/gc).
# MESHBLE_ADMIN_TOKEN=
